{
  "apps": [
    {
      "name": "webrtc_signalling_python",
      "script": "src/python/src/signaling-server.py",
      "interpreter": "./venv/bin/python3",
      "args": "8000",
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "webrtc_signalling_go",
      "script": "src/go/src/signaling-server.go",
      "interpreter": "go",
      "args": "run -port 8443 -player player/ws.html",
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
