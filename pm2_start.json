{
  "apps": [
    {
      "name": "webrtc_prod",
      "script": "./signaling-server",
      "args": "-root . -port 8443 -https",
      "exec_mode": "fork",
      "autorestart": false,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "webrtc_dev",
      "cwd": "src/go",
      "script": "src/signaling-server.go",
      "interpreter": "go",
      "interpreter_args": "run",
      "args": "-root ../.. -port 8443 -https",
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
