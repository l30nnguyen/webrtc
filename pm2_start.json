{
  "apps": [
    {
      "name": "webrtc_python",
      "script": "src/python/src/signaling-server.py",
      "interpreter": "./venv/bin/python3",
      "args": "8000",
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "webrtc_go",
      "cwd": "src/go",
      "script": "src/signaling-server.go",
      "interpreter": "go",
      "interpreter_args": "run",
      "args": "-root ../.. -port 8443 -https",
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
