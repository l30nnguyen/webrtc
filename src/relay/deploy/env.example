# /etc/matrix-relay/env: the relay's flags (matrix-relay -h lists them).
# Defaults: -udp 0.0.0.0:3478 -tcp 0.0.0.0:80 -tls 0.0.0.0:443 (TLS only with -cert/-key).
# A host that already serves 80 or 443 (e.g. a control server) moves TCP/TLS:
#   -tcp 0.0.0.0:3478 -tls 0.0.0.0:5349
RELAY_FLAGS=-public-ip 203.0.113.10 -cert /etc/matrix-relay/tls/fullchain.pem -key /etc/matrix-relay/tls/privkey.pem -metrics 127.0.0.1:9641
