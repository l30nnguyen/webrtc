# /etc/matrix-relay/env: the relay's flags (matrix-relay -h lists them).
# Defaults: -udp 0.0.0.0:3478 -tcp 0.0.0.0:80 -tls 0.0.0.0:443 (TLS only with -cert/-key).
# A host that already serves 80 or 443 (e.g. a control server) moves TCP/TLS:
#   -tcp 0.0.0.0:3478 -tls 0.0.0.0:5349
# -max 8000: each viewing session holds allocations (camera and viewer) even when
# it plays over LAN or direct, so the default 1000 is too few.
# -max-per-user 64: the camera's minted name counts its own allocations and the
# viewers' (they use the credentials the camera hands them): about 3 per view
# on the first relay. Cameras before 2.2.3 also leave theirs for 10 minutes
# after a view, so the default 16 is reached after ~5 views of one camera.
RELAY_FLAGS=-public-ip 203.0.113.10 -cert /etc/matrix-relay/tls/fullchain.pem -key /etc/matrix-relay/tls/privkey.pem -metrics 127.0.0.1:9641 -max 8000 -max-per-user 64
