#!/bin/bash
# matrix-backup: an encrypted copy of this server's state (roll-out.md R3).
# Installed as /usr/local/sbin/matrix-backup on every control server (by
# setup.sh) and relay. The admin server pulls the copies (matrix-admin backup);
# servers never send anything themselves.
#
#   sudo matrix-backup install-key backup.pub.asc   once: the public key copies are encrypted to
#   sudo matrix-backup snapshot > copy.tar.gz.gpg   write one encrypted copy to stdout
#   sudo matrix-backup paths                        what a copy holds on this server
#
# A copy is a tar.gz of the state below plus MANIFEST.sha256, encrypted to the
# backup public key. Only the holder of the private key (kept offline) can
# read it. Restore: server_operation.md section 3.6.
set -euo pipefail

PUBKEY=/etc/matrix-backup.pub.asc

# What is copied, relative to /. Missing paths are skipped, so one list fits
# the Center, control nodes and relays.
STATE_PATHS=(
    opt/matrix/cfg/sid
    opt/matrix/cfg/config.json
    opt/matrix/cfg/config.d
    opt/matrix/cfg/relay-secrets.json
    opt/matrix/cfg/turn.conf
    opt/matrix/cfg/version
    opt/matrix/RELEASE
    etc/matrix/matrix.conf
    etc/matrix-relay
    etc/systemd/system/matrix.service
    etc/systemd/system/matrix-relay.service
)
# Data inside the paths above that is not worth copying (none today).
EXCLUDES=()

die() { echo "matrix-backup: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "run with sudo"

cmd_install_key() {
    local file="${1:-}"
    [[ -f "$file" ]] || die "usage: matrix-backup install-key FILE"
    local check; check="$(mktemp -d)"
    trap 'rm -rf "$check"' RETURN
    local keys; keys="$(gpg --homedir "$check" --batch --show-keys --with-colons "$file" 2>/dev/null)" ||
        die "$file is not a gpg key"
    grep -q '^sec' <<<"$keys" && die "$file holds a private key; give the public key only"
    grep -q '^pub' <<<"$keys" || die "$file holds no public key"
    install -m 644 "$file" "$PUBKEY"
    echo "installed $PUBKEY ($(awk -F: '/^fpr/ {print $10; exit}' <<<"$keys"))"
}

cmd_paths() {
    local p
    for p in "${STATE_PATHS[@]}"; do
        [[ -e "/$p" ]] && echo "/$p"
    done
    return 0
}

cmd_snapshot() {
    [[ -f "$PUBKEY" ]] || die "no key; run install-key first"
    [[ -t 1 ]] && die "write the copy to a file or pipe, not the terminal"
    # Global, so the EXIT trap still sees it after the function returns.
    SNAP_TMP="$(mktemp -d)"
    trap 'rm -rf "$SNAP_TMP"' EXIT
    local tmp="$SNAP_TMP"
    mkdir -m 700 "$tmp/state" "$tmp/gnupg"
    local p found=0
    for p in "${STATE_PATHS[@]}"; do
        [[ -e "/$p" ]] || continue
        cp -a --parents "/$p" "$tmp/state/"
        found=1
    done
    [[ $found -eq 1 ]] || die "nothing to back up on this server"
    for p in "${EXCLUDES[@]}"; do rm -rf "${tmp:?}/state/$p"; done
    {
        echo "host=$(hostname)"
        echo "taken=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        [[ -f /opt/matrix/RELEASE ]] && sed -n 's/^version=/server_version=/p' /opt/matrix/RELEASE
        command -v matrix-relay >/dev/null && echo "relay_binary_sha256=$(sha256sum "$(command -v matrix-relay)" | cut -d" " -f1)"
    } > "$tmp/state/BACKUP_INFO"
    (cd "$tmp/state" && find . -type f -print0 | sort -z | xargs -0 sha256sum > "$tmp/MANIFEST.sha256" &&
        mv "$tmp/MANIFEST.sha256" MANIFEST.sha256)
    tar -C "$tmp/state" -czf - . |
        gpg --homedir "$tmp/gnupg" --batch --quiet --no-tty --trust-model always \
            --recipient-file "$PUBKEY" --encrypt
}

case "${1:-}" in
    install-key) shift; cmd_install_key "$@" ;;
    snapshot) cmd_snapshot ;;
    paths) cmd_paths ;;
    *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
